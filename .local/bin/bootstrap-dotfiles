#!/usr/bin/env bash
# Bootstrap script for setting up a new Arch Linux machine

echo "=> Starting dotfiles bootstrap..."

# 1. Install dependencies
echo "=> Installing essential packages via yay..."
if ! command -v yay &> /dev/null; then
    echo "yay is not installed. Please install yay first (https://github.com/Jguer/yay)."
    exit 1
fi

packages=(
    "hyprland" "waybar" "rofi" "kitty" "btop" "yazi" "zsh" "eza" "bat" "ripgrep"
    "zoxide" "mise" "easyeffects" "stow" "git" "curl" "wget" "oh-my-posh"
)

yay -S --needed --noconfirm "${packages[@]}"

# 2. Change shell
if [ "$SHELL" != "/bin/zsh" ] && [ "$SHELL" != "/usr/bin/zsh" ]; then
    echo "=> Changing default shell to zsh..."
    chsh -s $(which zsh)
fi

echo "=> Bootstrap complete! Ensure your .cfg bare repo is cloned to ~/.cfg."
