{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "color": {
            "1": "#999208",
            "2": "#999208"
        },
        "padding": {
            "top": 2,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#999208",
            "title": "#D8A664"
        },
        "key": {
            "type": "both"
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "─"
        },
        "os",
        "host",
        "kernel",
        "uptime",
        "packages",
        "shell",
        "display",
        "wm",
        "theme",
        "icons",
        "font",
        "cursor",
        "terminal",
        "terminalfont",
        "cpu",
        "gpu",
        "memory",
        "swap",
        "disk",
        "localip",
        "battery",
        "locale",
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
