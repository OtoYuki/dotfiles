#!/usr/bin/env bash
#
# Update packages from the official and unofficial user repositories
# Passing "module" returns the update status in JSON format
#
# Requires pacman-contrib (checkupdates)
#
# Author:  Jesse Mirabel <sejjymvm@gmail.com>
# Date:    August 16, 2025
# License: MIT

FG_GREEN="\e[32m"
FG_BLUE="\e[34m"
FG_RESET="\e[39m"

TIMEOUT=10
HELPERS=( aura paru pikaur trizen yay )
# Minimum seconds between AUR RPC queries (see cooldown guard below).
AUR_MIN_INTERVAL=1800
AUR_CACHE="${XDG_CACHE_HOME:-$HOME/.cache}/waybar/aur-updates"

printf() {
	command printf "$@" >&2
}

get_helper() {
	local helper
	for helper in "${HELPERS[@]}"; do
		if command -v "$helper" > /dev/null; then
			HELPER=$helper
			break
		fi
	done
}

check_updates() {
	local output status

	output=$(timeout $TIMEOUT checkupdates)
	status=$?

	if ((status != 0 && status != 2)); then
		FAILED=true
		return 1
	fi

	UPDATES=$(grep -c . <<< "$output")

	if [[ -z $HELPER ]]; then
		return 0
	fi

	local aur_output aur_status now stamp

	# Cooldown guard: the AUR RPC rate-limits per IP (HTTP 429) and a ban can
	# last hours. Never query it more than once per $AUR_MIN_INTERVAL seconds,
	# no matter how often this module is re-executed.
	now=$(date +%s)
	stamp=0
	[[ -r $AUR_CACHE ]] && read -r stamp aur_output < "$AUR_CACHE"
	[[ $stamp =~ ^[0-9]+$ ]] || stamp=0
	[[ $aur_output =~ ^[0-9]+$ ]] || aur_output=0

	if (( now - stamp < AUR_MIN_INTERVAL )); then
		AUR_UPDATES=${aur_output:-0}
		return 0
	fi

	aur_output=$(timeout $TIMEOUT "$HELPER" -Quaq)
	aur_status=$?

	if ((${#aur_output} > 0 && aur_status != 0)); then
		FAILED=true
		return 1
	fi

	AUR_UPDATES=$(grep -c . <<< "$aur_output")

	# Only cache a successful query, so a rate-limited/timed-out lookup
	# is not remembered as "0 updates" for the whole cooldown.
	(( aur_status == 0 )) || return 0
	mkdir -p "${AUR_CACHE%/*}"
	# NOTE: printf is shadowed above to write to stderr -- use command printf.
	command printf '%s %s\n' "$now" "$AUR_UPDATES" > "$AUR_CACHE"
}

update_packages() {
	printf "%bUpdating pacman packages...%b\n" "$FG_BLUE" "$FG_RESET"
	sudo pacman -Syu

	if [[ -n $HELPER ]]; then
		printf "\n%bUpdating AUR packages...%b\n" "$FG_BLUE" "$FG_RESET"
		"$HELPER" -Syu
	fi

	notify-send "Update Complete" -i "package-install"

	printf "\n%bUpdate complete!%b\n" "$FG_GREEN" "$FG_RESET"
	read -rsn 1 -p "Press any key to exit..."
}

display_module() {
	local icon tooltip

	if $FAILED; then
		icon='󰒑'
		tooltip="<b>Failed to fetch updates</b>\nRight-click to retry"
	elif ((UPDATES + AUR_UPDATES == 0)); then
		icon='󰸟'
		tooltip="No updates available"
	else
		icon='󰄠'
		tooltip="<b>Pacman</b>: $UPDATES"

		if [[ -n $HELPER ]]; then
			local padding
			printf -v padding "%*s" $((6 - ${#HELPER})) ''

			tooltip+="\n<b>${HELPER^}</b>: $padding$AUR_UPDATES"
		fi
	fi

	cat <<- EOF
		{ "text": "$icon", "tooltip": "$tooltip" }
	EOF
}

main() {
	FAILED=false
	UPDATES=0
	AUR_UPDATES=0

	get_helper

	case $1 in
		module)
			check_updates
			display_module
			;;
		*)
			# Interactive run: refresh the module on exit.
			# NOTE: never arm this in "module" mode -- waybar's "signal": 1
			# re-execs the module, so the trap would retrigger itself forever
			# and hammer the AUR RPC into a 429 rate limit.
			trap "pkill -RTMIN+1 waybar" EXIT

			printf "%bChecking for updates...%b\n" "$FG_BLUE" "$FG_RESET"

			check_updates
			update_packages
			;;
	esac
}

main "$@"
