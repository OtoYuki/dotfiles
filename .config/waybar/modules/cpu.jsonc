{
	"cpu": {
		"interval": 2,
		"format": "<span font_family='Goga' font_size='9pt' font_weight='bold' foreground='#5A6042'>CPU</span> <span font_family='Geist Mono' font_weight='bold' foreground='#999208'>{usage}%</span>",
		"states": {
			"warning": 75,
			"critical": 90
		},
		"tooltip-format": "CPU Compute: {usage}%\nCores: {cores}"
	}
}
