{
	"mpris": {
		"format": "<span font_family='Goga' font_size='8pt' font_weight='bold' foreground='#999208'>PLAY</span> <span font_family='Geist Mono' font_weight='bold' foreground='#FBFFE1'>{title}</span>",
		"format-paused": "<span font_family='Goga' font_size='8pt' font_weight='bold' foreground='#5A6042'>PAUSE</span> <span font_family='Geist Mono' font_weight='bold' foreground='#5A6042'>{title}</span>",
		"tooltip-format": "Playing: {title} - {artist}",
		"tooltip-format-paused": "Paused: {title} - {artist}",
		"max-length": 32,
		"ellipsis": "…"
	}
}
