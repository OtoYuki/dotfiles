{
	"memory": {
		"interval": 4,
		"format": "<span font_family='Goga' font_size='9pt' font_weight='bold' foreground='#5A6042'>RAM</span> <span font_family='Geist Mono' font_weight='bold' foreground='#D1CF8B'>{percentage}%</span>",
		"states": {
			"warning": 75,
			"critical": 90
		},
		"tooltip-format": "Memory: {used:0.1f}GiB / {total:0.1f}GiB ({percentage}%)"
	}
}
