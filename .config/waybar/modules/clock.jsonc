{
	"clock": {
		"interval": 1,
		"format": "<span font_family='Freigeist' font_weight='800' font_size='11pt' foreground='#FBFFE1'>{0:%H:%M}</span> <span font_family='Geist Mono' foreground='#5A6042'>::</span> <span font_family='Goga' font_weight='bold' font_size='10pt' foreground='#D1CF8B'>{0:%a %d %b}</span>",
		"format-alt": "<span font_family='Freigeist' font_weight='800' font_size='11pt' foreground='#FBFFE1'>{0:%H:%M:%S}</span> <span font_family='Geist Mono' foreground='#999208'>::</span> <span font_family='Goga' font_weight='bold' font_size='10pt' foreground='#FBFFE1'>{0:%Y-%m-%d}</span>",
		"tooltip-format": "<tt><small>{calendar}</small></tt>",
		"calendar": {
			"mode": "month",
			"mode-mon-col": 3,
			"weeks-pos": "right",
			"on-scroll": 1,
			"format": {
				"months": "<span color='#FBFFE1'><b>{}</b></span>",
				"days": "<span color='#D1CF8B'>{}</span>",
				"weeks": "<span color='#5A6042'><b>W{}</b></span>",
				"weekdays": "<span color='#999208'><b>{}</b></span>",
				"today": "<span color='#141C10' background='#D8A664'><b><u>{}</u></b></span>"
			}
		},
		"actions": {
			"on-click-right": "mode",
			"on-scroll-up": "shift_up",
			"on-scroll-down": "shift_down"
		}
	}
}
