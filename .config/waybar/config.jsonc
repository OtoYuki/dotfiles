{
	"include": [
		"~/.config/waybar/modules/*.jsonc",
		"~/.config/waybar/modules/hyprland/*.jsonc",
		"~/.config/waybar/modules/extras/*.jsonc"
	],

	/*------------
	    Layout
	------------*/

	"modules-left": [
		"hyprland/workspaces",
		"hyprland/window"
	],
	"modules-center": [
		"clock"
	],
	"modules-right": [
		"mpris",
		"group/hardware",
		"tray"
	],

	/*-------------
	    Options
	-------------*/

	"layer": "top",
	"position": "top",
	"margin-top": 0,
	"margin-bottom": 0,
	"margin-left": 0,
	"margin-right": 0,
	"spacing": 8,
	"reload_style_on_change": true
}
